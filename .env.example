# Staging / local env — set real values in Netlify or a gitignored .env
# Do not commit live keys.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional: override proof upload endpoint if not using Netlify
# VITE_UPLOAD_PROOF_ENDPOINT=http://localhost:8888/.netlify/functions/upload-proof
# VITE_PROOF_PHOTO_BUCKET=proof-photos

# Server-only (Netlify functions / scripts — never VITE_)
# Personal Gmail bot: OAuth (password will not work)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=
# Optional service-account fallback:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
